{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Convo",
  "version": "1.0.0",
  "identifier": "com.convo.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Convo",
        "width": 1360,
        "height": 840,
        "minWidth": 1050,
        "minHeight": 680,
        "center": true,
        "decorations": false,
        "transparent": false,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": []
  }
}
