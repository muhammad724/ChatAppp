NODE_ENV=development
PORT=4000
# Supabase project settings > Database > Connection string (use the pooled URL locally)
DATABASE_URL=postgresql://postgres.PROJECT:PASSWORD@HOST:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.PROJECT:PASSWORD@HOST:5432/postgres
SUPABASE_URL=https://PROJECT.supabase.co
# Server only. Never copy this value to mobile/.env
SUPABASE_SERVICE_ROLE_KEY=replace-me
CLOUDINARY_CLOUD_NAME=replace-me
CLOUDINARY_API_KEY=replace-me
# Server only. Never copy this value to mobile/.env
CLOUDINARY_API_SECRET=replace-me
CORS_ORIGINS=http://localhost:8081
MAX_IMAGE_BYTES=10485760
